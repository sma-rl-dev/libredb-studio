#!/usr/bin/env bash
set -euo pipefail

# libredb-studio - Tester Environment CLI
# Usage: ./tester-env <command> [--run-id <id>] [--port <port>]
# Commands: deploy, seed, verify, reset, stop, logs, status, url, help
#
# Source build: the checkout's own Dockerfile (oven/bun deps -> node:26 trixie
# builder running `next build` -> standalone runtime) through
# docker-compose.tester-env.yml. Deterministic env, credentials and reset path are
# also recorded in status/apps/libredb-studio.toml and DEPLOY-SMA.md.

RUN_ID="default"
PORT="13390"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="${SCRIPT_DIR}/docker-compose.tester-env.yml"

ADMIN_EMAIL="admin@libredb.org"
ADMIN_PASSWORD="test-admin"
USER_EMAIL="user@libredb.org"
USER_PASSWORD="test-user"
SQLITE_SAMPLE_ID="seed:sqlite-embedded-sample"
# Deterministic workspace state (saved queries, query history, active connection)
# pushed by `seed` into the admin account's server-side storage.
SEED_DATA_FILE="${SCRIPT_DIR}/tester-env-seed-data.json"

refresh_names() {
    local suffix=""
    if [[ "${RUN_ID}" != "default" ]]; then
        suffix="-${RUN_ID}"
    fi

    CONTAINER_NAME="tester-env-libredb-studio${suffix}"
    # IMAGE_TAG set by scripts/rl-env to a content-addressed tag so identical
    # (baseline, patch-set) combos share an image. Manual invocations get :dev.
    IMAGE_NAME="${IMAGE_TAG:-tester-env-libredb-studio:dev}"
    COMPOSE_PROJECT="${COMPOSE_PROJECT_NAME:-tester-env-libredb-studio${suffix}}"
    DATA_VOLUME="libredb-studio-data${suffix}"
}

compose() {
    docker compose \
        -p "${COMPOSE_PROJECT}" \
        -f "${COMPOSE_FILE}" \
        --project-directory "${SCRIPT_DIR}" \
        "$@"
}

compose_env() {
    COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT}" \
    CONTAINER_NAME="${CONTAINER_NAME}" \
    IMAGE_TAG="${IMAGE_NAME}" \
    DATA_VOLUME="${DATA_VOLUME}" \
    PORT="${PORT}" \
    compose "$@"
}

base_url() {
    echo "http://127.0.0.1:${PORT}"
}

wait_for_health() {
    local attempt
    for attempt in $(seq 1 180); do
        if curl -s -o /dev/null -w '%{http_code}' "$(base_url)/api/health" 2>/dev/null | grep -qx '200'; then
            echo "==> App healthy after ${attempt}s"
            return 0
        fi
        sleep 1
    done

    echo "Error: app did not become healthy at $(base_url)/api/health" >&2
    compose_env logs --tail 100 >&2 || true
    exit 1
}

require_running() {
    if ! compose_env ps --status running --format '{{.Name}}' 2>/dev/null | grep -qx "${CONTAINER_NAME}"; then
        echo "Error: container ${CONTAINER_NAME} is not running. Run './tester-env deploy' first." >&2
        exit 1
    fi
}

# login <email> <password> <cookie-jar> -> prints the role from the response
login() {
    local body
    body="$(curl -s -c "$3" -X POST "$(base_url)/api/auth/login" \
        -H 'Content-Type: application/json' \
        -d "{\"email\":\"$1\",\"password\":\"$2\"}")" || {
        echo "Error: login request as $1 failed (is the app up?)." >&2
        return 1
    }

    BODY="${body}" EMAIL="$1" python3 -c 'import json,os,sys
raw = os.environ["BODY"]
try:
    body = json.loads(raw)
except ValueError:
    sys.exit("login as " + os.environ["EMAIL"] + " returned non-JSON: " + raw[:200])
if not body.get("success"):
    sys.exit("login refused: " + json.dumps(body))
print(body["role"])'
}

api_get() {
    curl -sf -b "$2" "$(base_url)$1"
}

api_post() {
    curl -s -b "$2" -X POST "$(base_url)$1" -H 'Content-Type: application/json' -d "$3"
}

api_put() {
    curl -s -b "$2" -X PUT "$(base_url)$1" -H 'Content-Type: application/json' -d "$3"
}

# managed_connections <cookie-jar> -> JSON body of /api/connections/managed
managed_connections() {
    api_get "/api/connections/managed" "$1"
}

# wait_for_sample <cookie-jar>: the sample copy is asynchronous at boot, so poll
# until pendingSeeds is empty (and fail if the sample never appears).
wait_for_sample() {
    local attempt listing
    for attempt in $(seq 1 60); do
        listing="$(managed_connections "$1")" || true
        if [[ -n "${listing}" ]]; then
            if LISTING="${listing}" list_has_sample; then
                return 0
            fi
            if LISTING="${listing}" pending_seeds_cleared; then
                echo "Error: boot finished seeding but ${SQLITE_SAMPLE_ID} is not listed for the admin role." >&2
                echo "       ${listing}" >&2
                exit 1
            fi
        fi
        sleep 1
    done

    echo "Error: ${SQLITE_SAMPLE_ID} did not appear within 60s (pendingSeeds never drained)." >&2
    exit 1
}

list_has_sample() {
    LISTING="${LISTING:-}" ID="${SQLITE_SAMPLE_ID}" python3 -c 'import json,os,sys
listing = json.loads(os.environ.get("LISTING") or "{}")
ids = {c.get("id") for c in listing.get("connections", [])}
sys.exit(0 if os.environ["ID"] in ids else 1)'
}

pending_seeds_cleared() {
    LISTING="${LISTING:-}" python3 -c 'import json,os,sys
listing = json.loads(os.environ.get("LISTING") or "{}")
sys.exit(0 if not listing.get("pendingSeeds") else 1)'
}

cmd_deploy() {
    echo "==> Building image from source: ${IMAGE_NAME}"
    echo "    (cold build: bun install --frozen-lockfile with native toolchain + next build;"
    echo "     source mutations reuse the lockfile-keyed deps layer and re-run next build only)"

    echo "==> Starting container ${CONTAINER_NAME} on port ${PORT}..."
    compose_env up -d --build

    wait_for_health

    echo "==> Deployment complete."
    echo "    URL:      http://localhost:${PORT}/"
    echo "    Browser:  ${TESTER_ENV_BROWSER_ORIGIN:-http://host.docker.internal:${PORT}/}"
    echo "    Admin:    ${ADMIN_EMAIL} / ${ADMIN_PASSWORD}"
    echo "    User:     ${USER_EMAIL} / ${USER_PASSWORD}"
    echo "    Sample:   ${SQLITE_SAMPLE_ID} (SQLite employee.db, copied at boot, admin-only)"
}

# The built-in SQLite sample is copied once at boot into the data volume; it is
# not re-copied on demand. `seed` waits for that copy, asserts the pinned bytes,
# then replaces the admin's workspace collections (active connection, saved
# queries, query history) with tester-env-seed-data.json. PUT replaces a
# collection wholesale, so re-running seed is idempotent and also clears
# anything a browser session left behind.
cmd_seed() {
    require_running
    echo "==> Waiting for the boot-time sample copy (${SQLITE_SAMPLE_ID})..."

    local jar
    jar="$(mktemp)"
    login "${ADMIN_EMAIL}" "${ADMIN_PASSWORD}" "${jar}" >/dev/null
    wait_for_sample "${jar}"

    local size
    size="$(compose_env exec -T app stat -c %s /app/data/sample-employees.db 2>/dev/null | tr -d '\r')"
    if [[ "${size}" != "815104" ]]; then
        echo "Error: /app/data/sample-employees.db is '${size}' bytes, expected 815104 (the pinned asset)." >&2
        echo "       Use './tester-env reset' then './tester-env deploy' to replay the boot copy." >&2
        exit 1
    fi
    echo "==> Seed present: SQLite sample (815104 bytes) listed as ${SQLITE_SAMPLE_ID}."

    if [[ ! -f "${SEED_DATA_FILE}" ]]; then
        echo "Error: ${SEED_DATA_FILE} is missing (the deterministic workspace payload)." >&2
        exit 1
    fi

    echo "==> Seeding admin workspace state from $(basename "${SEED_DATA_FILE}")..."
    seed_collection active_connection_id "${jar}"
    seed_collection saved_queries "${jar}"
    seed_collection history "${jar}"
    rm -f "${jar}"

    SEED_DATA_FILE="${SEED_DATA_FILE}" python3 - <<'PY'
import json
import os

data = json.load(open(os.environ["SEED_DATA_FILE"]))
names = ", ".join(q["name"] for q in data["saved_queries"])
statuses = ", ".join(item["status"] for item in data["history"])
print(f"    saved:    {len(data['saved_queries'])} queries ({names})")
print(f"    history:  {len(data['history'])} runs ({statuses})")
print(f"    active:   {data['active_connection_id']}")
PY
    echo "==> Seed complete."
}

# seed_collection <collection> <cookie-jar>: replace one storage collection of the
# admin account with its value from the seed payload.
seed_collection() {
    local body response
    body="$(SEED_DATA_FILE="${SEED_DATA_FILE}" COLLECTION="$1" python3 -c 'import json,os
print(json.dumps({"data": json.load(open(os.environ["SEED_DATA_FILE"]))[os.environ["COLLECTION"]]}))')"
    response="$(api_put "/api/storage/$1" "$2" "${body}")"
    if [[ "${response}" != '{"ok":true}' ]]; then
        echo "Error: PUT /api/storage/$1 failed: ${response}" >&2
        exit 1
    fi
}

# verify_workspace <cookie-jar>: assert the seeded admin workspace — active
# connection, saved queries and query history — and run every saved query to
# prove the row counts the UI shows.
verify_workspace() {
    STORAGE_JAR="$1" BASE="$(base_url)" SEED_DATA_FILE="${SEED_DATA_FILE}" python3 - <<'PY'
import json
import os
import sys
import urllib.error
import urllib.request

base = os.environ["BASE"]
data_file = os.environ["SEED_DATA_FILE"]

header = None
with open(os.environ["STORAGE_JAR"]) as jar:
    for line in jar:
        # curl's Netscape jar marks HttpOnly cookies with a "#HttpOnly_" prefix.
        if line.startswith("#HttpOnly_"):
            line = line[len("#HttpOnly_") :]
        elif line.startswith("#") or not line.strip():
            continue
        parts = line.strip().split("\t")
        header = f"{parts[5]}={parts[6]}"


def request(path, payload=None):
    body = None if payload is None else json.dumps(payload).encode()
    req = urllib.request.Request(
        base + path,
        data=body,
        headers={"Cookie": header, "Content-Type": "application/json"},
        method="POST" if payload is not None else "GET",
    )
    try:
        with urllib.request.urlopen(req) as res:
            return json.loads(res.read())
    except urllib.error.HTTPError as err:
        return json.loads(err.read())


storage = request("/api/storage")

if storage.get("active_connection_id") != "seed:sqlite-embedded-sample":
    sys.exit(f"Error: active connection is {storage.get('active_connection_id')!r}, expected the employees sample")

saved = storage.get("saved_queries") or []
expected_saved = {
    "sq-headcount-by-department": "Headcount by department",
    "sq-average-salary-by-title": "Average salary by title",
    "sq-top-paid-employees": "Top 10 paid employees",
}
if len(saved) != len(expected_saved):
    sys.exit(f"Error: {len(saved)} saved queries, expected {len(expected_saved)}")
for query in saved:
    if expected_saved.get(query.get("id")) != query.get("name"):
        sys.exit(f"Error: saved query {query.get('id')!r} is named {query.get('name')!r}")
    if query.get("connectionType") != "sqlite":
        sys.exit(f"Error: saved query {query.get('id')} has type {query.get('connectionType')!r}, expected sqlite")

history = storage.get("history") or []
counts = {"success": 0, "error": 0}
for item in history:
    counts[item.get("status")] = counts.get(item.get("status"), 0) + 1
    if item.get("connectionName") != "Sample (Employees)":
        sys.exit(f"Error: history item {item.get('id')} names connection {item.get('connectionName')!r}")
if len(history) != 4 or counts != {"success": 3, "error": 1}:
    sys.exit(f"Error: history is {len(history)} runs with statuses {counts}, expected 4 (3 success, 1 error)")
print("    workspace: active connection + 3 saved queries + 4 history runs (3 success, 1 error)")

payload = {q["id"]: q["query"] for q in json.load(open(data_file))["saved_queries"]}
# Pinned results: the rows the UI shows for each saved query on the employees sample.
expectations = {
    "sq-headcount-by-department": (9, "dept_name", "Development", 203),
    "sq-average-salary-by-title": (6, "title", "Senior Staff", 78955),
    "sq-top-paid-employees": (10, "employee", "Arno Kumaresan", 136004),
}
for query_id, (rows, label_key, top_label, top_number) in expectations.items():
    body = request("/api/db/query", {"connectionId": "seed:sqlite-embedded-sample", "sql": payload[query_id]})
    if body.get("error"):
        sys.exit(f"Error: saved query {query_id} failed: {body['error']}")
    if body.get("rowCount") != rows:
        sys.exit(f"Error: saved query {query_id} returned {body.get('rowCount')} rows, expected {rows}")
    top = body["rows"][0]
    if top.get(label_key) != top_label:
        sys.exit(f"Error: saved query {query_id} first {label_key} is {top.get(label_key)!r}, expected {top_label!r}")
    numbers = [v for v in top.values() if isinstance(v, (int, float))]
    if top_number not in numbers:
        sys.exit(f"Error: saved query {query_id} first row {top} does not carry {top_number}")
    print(f"    saved:    {query_id} -> {rows} rows, first {top_label} ({top_number})")

failed = request("/api/db/query", {"connectionId": "seed:sqlite-embedded-sample", "sql": "SELECT * FROM employees;"})
if failed.get("code") != "QUERY_ERROR":
    sys.exit(f"Error: the seeded failed statement returned {failed}, expected a QUERY_ERROR")
print("    history:  the seeded failed run replays as QUERY_ERROR 'no such table: employees'")
PY
}

cmd_verify() {
    require_running
    local jar user_jar
    jar="$(mktemp)"
    user_jar="$(mktemp)"

    echo "==> Verifying libredb-studio deployment..."

    local code
    code="$(curl -s -o /dev/null -w '%{http_code}' "$(base_url)/")"
    if [[ "${code}" != "200" && "${code}" != "302" && "${code}" != "307" && "${code}" != "308" ]]; then
        echo "Error: GET / returned ${code}, expected 200 or an auth redirect." >&2
        exit 1
    fi
    echo "    UI:       GET / -> ${code}"

    local role
    role="$(login "${ADMIN_EMAIL}" "${ADMIN_PASSWORD}" "${jar}")"
    if [[ "${role}" != "admin" ]]; then
        echo "Error: ${ADMIN_EMAIL} logged in with role '${role}', expected admin." >&2
        exit 1
    fi
    echo "    auth:     admin login OK (${ADMIN_EMAIL})"

    wait_for_sample "${jar}"

    local listing
    listing="$(managed_connections "${jar}")"
    LISTING="${listing}" python3 - <<'PY'
import json
import os
import sys

listing = json.loads(os.environ["LISTING"])
conn = next((c for c in listing["connections"] if c.get("id") == "seed:sqlite-embedded-sample"), None)
if conn is None:
    sys.exit("Error: admin listing has no seed:sqlite-embedded-sample")
if conn.get("name") != "Sample (Employees)" or conn.get("type") != "sqlite":
    sys.exit(f"Error: sample is {conn.get('name')!r}/{conn.get('type')!r}, expected 'Sample (Employees)'/sqlite")
if listing.get("pendingSeeds"):
    sys.exit(f"Error: pendingSeeds is not empty: {listing['pendingSeeds']}")
print(f"    samples:  {conn['id']} -> {conn['name']} ({conn['type']})")
PY

    local result
    result="$(api_post "/api/db/query" "${jar}" "{\"connectionId\":\"${SQLITE_SAMPLE_ID}\",\"sql\":\"SELECT COUNT(*) AS employee_count FROM employee\"}")" || {
        echo "Error: POST /api/db/query failed (network error)." >&2
        exit 1
    }
    RESULT="${result}" python3 - <<'PY'
import json
import os
import sys

body = json.loads(os.environ["RESULT"])
values = [v for row in body.get("rows", []) for v in row.values()]
if body.get("rowCount") != 1:
    sys.exit(f"Error: employee count query returned rowCount={body.get('rowCount')!r}, expected 1")
if 1000 not in values:
    sys.exit(f"Error: employee count is {values!r}, expected 1000")
print(f"    query:    SELECT COUNT(*) FROM employee -> {values[0]} rows, employee table = 1000")
PY

    verify_workspace "${jar}"

    # The SQLite sample is admin-only (upstream REFUSES_DENIED_FILE_ACCESS), so the
    # lower role must not see it: this is the RBAC filter, not UI chrome.
    role="$(login "${USER_EMAIL}" "${USER_PASSWORD}" "${user_jar}")"
    if [[ "${role}" != "user" ]]; then
        echo "Error: ${USER_EMAIL} logged in with role '${role}', expected user." >&2
        exit 1
    fi
    listing="$(managed_connections "${user_jar}")"
    LISTING="${listing}" python3 -c 'import json,os,sys
listing = json.loads(os.environ["LISTING"])
conns = listing.get("connections", [])
ids = {c.get("id") for c in conns}
if "seed:sqlite-embedded-sample" in ids:
    sys.exit("Error: the admin-only SQLite sample is listed for the user role")
if ids != {"seed:libredb-embedded-sample"}:
    sys.exit(f"Error: the user role lists {sorted(ids)}, expected only the LibreDB sample")
print("    rbac:     user login OK, only the LibreDB sample listed and the admin-only sample hidden")'

    rm -f "${jar}" "${user_jar}"
    echo "==> Verify passed."
}

cmd_reset() {
    echo "==> Resetting environment (drop container and the /app/data volume)..."
    compose_env down -v --remove-orphans || true
    echo "==> Reset complete. Run './tester-env deploy' to replay accounts and the sample copy."
}

cmd_stop() {
    echo "==> Stopping container (volume preserved)..."
    compose_env down
}

cmd_logs() {
    compose_env logs -f --tail 100 "$@"
}

cmd_status() {
    if compose_env ps --status running --format '{{.Name}}' 2>/dev/null | grep -qx "${CONTAINER_NAME}"; then
        local running_image
        running_image="$(docker inspect --format '{{.Config.Image}}' "${CONTAINER_NAME}" 2>/dev/null || echo "${IMAGE_NAME}")"
        echo "Status: RUNNING"
        echo "URL: http://localhost:${PORT}/"
        echo "Browser URL: ${TESTER_ENV_BROWSER_ORIGIN:-http://host.docker.internal:${PORT}/}"
        echo "Container: ${CONTAINER_NAME}"
        echo "Image: ${running_image}"
        echo "Volume: ${DATA_VOLUME} (/app/data)"
        echo "Admin: ${ADMIN_EMAIL} / ${ADMIN_PASSWORD}"
        echo "User: ${USER_EMAIL} / ${USER_PASSWORD}"
    else
        echo "Status: NOT RUNNING"
    fi
}

cmd_url() {
    echo "http://localhost:${PORT}/"
    echo "browser: ${TESTER_ENV_BROWSER_ORIGIN:-http://host.docker.internal:${PORT}/}"
}

cmd_help() {
    cat <<EOF
libredb-studio - Tester Environment CLI

Usage: ./tester-env <command> [--run-id <id>] [--port <port>]

Commands:
  deploy    Build the image from source, start the container, wait for health (alias: up)
  seed      Wait for the boot-time SQLite sample, then replace the admin workspace
            (active connection, 3 saved queries, 4 query-history runs) from
            tester-env-seed-data.json; re-running is idempotent and clears leftovers
  verify    Assert UI, both logins, the sample listing, a 1000-row query, the seeded
            workspace, each saved query's pinned rows and the role filter
  reset     Remove the container and the /app/data volume (down -v) for a clean first boot
  stop      Stop the container and keep the volume (alias: down)
  logs      Follow container logs
  status    Show whether the app is running and on which port
  url       Print the host URL and the browser-visible URL
  help      Show this help

Options:
  --run-id <id>   Isolate container/compose project/volume for parallel runs. Default: default
  --port <port>   Host port to bind to container port 3000. Default: 13390

Typical workflow:
  ./tester-env deploy    # Build, start, first boot
  ./tester-env seed      # Sample + deterministic admin workspace (saved queries, history)
  ./tester-env verify    # Check logins, sample, query, workspace rows and RBAC
  ./tester-env reset     # Clean slate (down -v)

Deployment details:
  - Baseline: 1.3.0 (58adba536f0283fecb7b761053cb2401dd7187eb)
  - Built from this checkout with the repo's own Dockerfile: bun 1.4.4 deps
    stage (lockfile-keyed, so source mutations reuse it), node:26 trixie builder
    running \`next build\`, standalone runtime on the same node trixie image.
  - Server-side storage: STORAGE_PROVIDER=sqlite at /app/data/libredb-storage.db,
    so accounts, connections and saved queries survive a restart and die with the
    volume.
  - One named volume at /app/data (SQLite store + copied sample + workflow
    ledger); reset is down -v.
  - AUTH_COOKIE_SECURE=false because the browser reaches the app over plain HTTP
    at the bridge gateway.
  - The SQLite sample is digest-pinned and copied at boot; it is admin-only.

Credentials:
  ${ADMIN_EMAIL} / ${ADMIN_PASSWORD}  (role: admin)
  ${USER_EMAIL} / ${USER_PASSWORD}    (role: user, query execution only)

Environment:
  IMAGE_TAG                   Content-addressed image tag exported by scripts/rl-env
  TESTER_ENV_BROWSER_ORIGIN   Browser-visible origin for container browsers
  PORT                        Host port (same as --port)
  ADMIN_PASSWORD, USER_PASSWORD  Override the compose defaults if a scenario needs it

Caveats:
  - Accounts are seeded from env only while the accounts table is empty. Change
    ADMIN_PASSWORD with ADMIN_PASSWORD_RESET=true, or reset the volume.
  - seed replaces the admin account's active connection, saved queries and query
    history via PUT /api/storage/<collection>, so it restores the canonical
    workspace and drops whatever a browser session saved. A signed-in browser
    picks the server copy up on its next load; re-run seed if a stale local copy
    was migrated first.
  - The seeded queries and history belong to the admin account and to the sqlite
    sample: the UI lists them only while 'Sample (Employees)' is the active
    connection (both panels filter by connection type/id).
  - Any src/ change needs a rebuild; the deps layer is cached but \`next build\`
    re-runs in full (minutes), so mutation batches are expensive here.
  - Writes to the sample database persist in the volume until a reset.
EOF
}

main() {
    local cmd="${1:-help}"
    shift || true

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --run-id)
                RUN_ID="${2:?--run-id requires a value}"
                shift 2
                ;;
            --port)
                PORT="${2:?--port requires a value}"
                shift 2
                ;;
            --help|-h)
                cmd_help
                exit 0
                ;;
            *)
                echo "Unknown option: $1" >&2
                cmd_help
                exit 1
                ;;
        esac
    done

    refresh_names

    case "${cmd}" in
        deploy|up) cmd_deploy ;;
        seed) cmd_seed ;;
        verify) cmd_verify ;;
        reset) cmd_reset ;;
        stop|down) cmd_stop ;;
        logs) cmd_logs ;;
        status) cmd_status ;;
        url) cmd_url ;;
        help|--help|-h) cmd_help ;;
        *)
            echo "Unknown command: ${cmd}" >&2
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
